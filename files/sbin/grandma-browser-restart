#!/usr/bin/env bash
# REQUIRES ROOT: sends signals to processes owned by the 'grandma' user.
set -euo pipefail

TARGET_USER="grandma"
candidates="brave brave-browser brave-browser-stable"

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  cat <<'EOF'
Usage: grandma-browser-restart

Cleanly stops Brave for the grandma user (SIGTERM, wait, SIGKILL if still
alive) so any stuck window/tab goes away. Requires root, since it signals
another user's processes. Does NOT relaunch Brave itself -- grandma clicks
her launcher buttons again to reopen whatever she needs.
EOF
  exit 0
fi

if [ "$EUID" -ne 0 ]; then
  echo "error: grandma-browser-restart requires root (signals another user's processes)" >&2
  exit 1
fi

binary_name=""
pids=""
for c in $candidates; do
  found=$(pgrep -u "$TARGET_USER" -x "$c" 2>/dev/null || true)
  if [ -n "$found" ]; then
    binary_name="$c"
    pids="$found"
    break
  fi
done

if [ -z "$pids" ]; then
  echo "No Brave process found for user $TARGET_USER; nothing to do."
  exit 0
fi

echo "Sending SIGTERM to $binary_name pids: $pids"
kill -TERM $pids 2>/dev/null || true

for _ in $(seq 1 10); do
  sleep 1
  still=$(pgrep -u "$TARGET_USER" -x "$binary_name" 2>/dev/null || true)
  [ -z "$still" ] && break
done

still=$(pgrep -u "$TARGET_USER" -x "$binary_name" 2>/dev/null || true)
if [ -n "$still" ]; then
  echo "Still alive after grace period, sending SIGKILL to: $still"
  kill -KILL $still 2>/dev/null || true
fi

echo "Brave stopped for $TARGET_USER. She'll need to tap a launcher button again to reopen anything."
