#!/usr/bin/env python3
"""GrandmaOS launcher: fullscreen, undecorated, huge square icon+label buttons.
Runs as grandma via her (root-owned, un-removable) autostart entry, under a
respawn supervisor (grandma-launcher-supervisor) so an accidental close just
brings it right back. No root needed -- it only launches Google Chrome
windows and calls the existing unprivileged grandma-volume/grandma-unmute
scripts, all in grandma's own session.
"""
import os
import subprocess
import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk, GdkPixbuf  # noqa: E402

ICON_DIR = "/usr/local/share/grandmaos/icons"
ICON_PX = 160
BUTTON_PX = 300

CSS = b"""
window { background-color: #000000; }
button {
    font-size: 30px;
    font-weight: bold;
    border-radius: 0;
    padding: 12px;
}
button:disabled {
    color: #888888;
}
label.section {
    font-size: 22px;
    font-weight: bold;
    color: #ffffff;
    margin-top: 10px;
}
"""

# Every launcher button opens a normal tab in Grandma's single Chrome profile.
# Chrome reuses its existing browser window when one is running and creates a
# maximized window when it is not.
SITES = [
    ("Facebook", "https://www.facebook.com/", "facebook.png"),
    ("YouTube", "https://www.youtube.com/", "youtube.png"),
]

TRUIST_URL = "https://www.truist.com/"


def launch_tab(url: str = "chrome://newtab/"):
    subprocess.Popen(
        [
            "google-chrome-stable",
            "--start-maximized",
            "--new-tab",
            url,
        ],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


def make_image(icon_file: str = None, icon_name: str = None, px: int = ICON_PX) -> Gtk.Image:
    if icon_file:
        path = os.path.join(ICON_DIR, icon_file)
        if os.path.isfile(path):
            try:
                pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, px, px, True)
                return Gtk.Image.new_from_pixbuf(pixbuf)
            except Exception:
                pass
    img = Gtk.Image.new_from_icon_name(icon_name or "image-missing", Gtk.IconSize.DIALOG)
    img.set_pixel_size(px)
    return img


def make_square_button(label_text: str, icon_file: str = None, icon_name: str = None,
                       button_px: int = BUTTON_PX, icon_px: int = ICON_PX) -> Gtk.Button:
    btn = Gtk.Button()
    btn.set_size_request(button_px, button_px)
    btn.set_hexpand(False)
    btn.set_vexpand(False)
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
    box.set_halign(Gtk.Align.CENTER)
    box.set_valign(Gtk.Align.CENTER)
    box.pack_start(make_image(icon_file, icon_name, icon_px), False, False, 0)
    label = Gtk.Label(label=label_text)
    box.pack_start(label, False, False, 0)
    btn.add(box)
    return btn


class Launcher(Gtk.Window):
    def __init__(self):
        super().__init__(title="GrandmaOS")
        self.set_decorated(False)
        self.fullscreen()
        self.connect("destroy", Gtk.main_quit)

        # Size controls from the logical desktop dimensions, not a presumed
        # panel resolution. This remains usable at 1x or 2x scaling and on an
        # external monitor while keeping generous touch targets.
        screen = Gdk.Screen.get_default()
        logical_w = screen.get_width()
        logical_h = screen.get_height()
        button_px = max(240, min(420, (logical_h - 140) // 2, (logical_w - 72) // 2))
        icon_px = max(144, min(256, (button_px * 3) // 5))

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        outer.set_margin_top(30)
        outer.set_margin_bottom(30)
        outer.set_margin_start(30)
        outer.set_margin_end(30)
        self.add(outer)

        apps_label = Gtk.Label(label="Apps")
        apps_label.get_style_context().add_class("section")
        outer.pack_start(apps_label, False, False, 0)

        apps_grid = Gtk.Grid()
        apps_grid.set_row_spacing(24)
        apps_grid.set_column_spacing(24)
        apps_grid.set_halign(Gtk.Align.CENTER)
        apps_grid.set_valign(Gtk.Align.CENTER)
        outer.pack_start(apps_grid, True, True, 0)

        for index, (name, url, icon_file) in enumerate(SITES):
            btn = make_square_button(name, icon_file=icon_file, button_px=button_px, icon_px=icon_px)
            btn.connect("clicked", lambda _b, u=url: launch_tab(u))
            apps_grid.attach(btn, index % 2, index // 2, 1, 1)

        internet_btn = make_square_button("Internet", icon_name="web-browser", button_px=button_px, icon_px=icon_px)
        internet_btn.connect("clicked", lambda _b: launch_tab())
        apps_grid.attach(internet_btn, 0, 1, 1, 1)

        bank_btn = make_square_button(
            "Banking",
            icon_file="truist.png",
            icon_name="emblem-money",
            button_px=button_px,
            icon_px=icon_px,
        )
        bank_btn.connect("clicked", lambda _b: launch_tab(TRUIST_URL))
        bank_btn.set_tooltip_text("Open Truist online banking")
        apps_grid.attach(bank_btn, 1, 1, 1, 1)


def main():
    provider = Gtk.CssProvider()
    provider.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_screen(
        Gdk.Screen.get_default(),
        provider,
        Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
    )
    win = Launcher()
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
