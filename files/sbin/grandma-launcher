#!/usr/bin/env python3
"""GrandmaOS permanent bottom dock.

The dock replaces both the fullscreen Apps screen and XFCE's window
switcher. Its fixed site buttons launch a Chrome window or raise the existing
window for that site, while the volume buttons adjust Grandma's own PipeWire
session. The window reserves space at the bottom edge so Chrome cannot cover it.
"""
import os
import subprocess
import time
from urllib.parse import urlparse

import gi
import pyatspi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GdkX11", "3.0")
from gi.repository import Gdk, GdkPixbuf, GdkX11, GLib, Gtk  # noqa: E402

ICON_DIR = "/usr/local/share/grandmaos/icons"
MAX_DOCK_HEIGHT_PX = 160
DOCK_HEIGHT_FRACTION = 8

CSS = b"""
window { background-color: #000000; }
button {
    font-size: 18px;
    font-weight: bold;
    border-radius: 0;
    border-width: 2px;
    padding: 4px;
}
.volume-arrow {
    font-size: 42px;
    font-weight: bold;
}
"""

# --class gives each app-style Chrome window a stable identity. That lets the
# same fixed button serve as both launcher and window switcher without showing
# Grandma a separate task list. Facebook is the only everyday site deliberately
# opened at session start; every other site remains on-demand.
SITES = [
    (
        "Facebook",
        "https://www.facebook.com/",
        "facebook.png",
        "www.facebook.com",
        True,
        None,
        True,
    ),
    (
        "Amazon",
        "https://www.amazon.com/",
        "amazon.png",
        "www.amazon.com",
        True,
        None,
        False,
    ),
    (
        "YouTube",
        "https://www.youtube.com/",
        "youtube.png",
        "www.youtube.com",
        True,
        None,
        False,
    ),
    (
        "Internet",
        "chrome://newtab/",
        None,
        "GrandmaOS-Internet",
        False,
        None,
        False,
    ),
    (
        "Banking",
        "https://www.truist.com/",
        "truist.png",
        "www.truist.com",
        True,
        None,
        False,
    ),
    (
        "AOL",
        "https://mail.aol.com/",
        "aol.png",
        "mail.aol.com",
        True,
        None,
        False,
    ),
]

LAUNCH_GUARD_SECONDS = 8
last_launch_time = {}


def quiet_run(command):
    try:
        return subprocess.run(
            command,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
    except FileNotFoundError:
        return None


def focus_window(window_class: str) -> bool:
    """Raise a Chrome window previously launched with our stable WM class."""
    try:
        listing = subprocess.check_output(
            ["wmctrl", "-lx"], stderr=subprocess.DEVNULL, text=True
        )
    except (FileNotFoundError, subprocess.CalledProcessError):
        return False

    marker = window_class.casefold()
    for line in listing.splitlines():
        fields = line.split(None, 4)
        # wmctrl -lx columns are: window ID, desktop, WM_CLASS, client
        # machine, title. Match the WM_CLASS column, not the machine name.
        if len(fields) >= 3 and marker in fields[2].casefold():
            result = quiet_run(["wmctrl", "-ia", fields[0]])
            return result is not None and result.returncode == 0
    return False


def focus_existing_tab(url: str) -> bool:
    """Activate an existing Chrome tab matching the target site's hostname."""
    hostname = (urlparse(url).hostname or "").casefold()
    site_name = hostname.removeprefix("www.").split(".", 1)[0]
    if not site_name or site_name == "newtab":
        return False

    def descendants(node):
        yield node
        try:
            # The browser UI contains the tab strip and one document node per
            # active tab. Its URI is enough; walking the entire webpage DOM
            # would make a button press unnecessarily slow on complex sites.
            if node.getRoleName() == "document web":
                return
            for child in node:
                yield from descendants(child)
        except Exception:
            return

    try:
        desktop = pyatspi.Registry.getDesktop(0)
    except Exception:
        return False

    for app in desktop:
        try:
            if "chrome" not in (app.name or "").casefold():
                continue
        except Exception:
            continue

        for node in descendants(app):
            try:
                role = node.getRoleName()
                name = (node.name or "").casefold()
            except Exception:
                continue

            matches = role == "page tab" and site_name in name
            if site_name == "facebook" and "messenger" in name:
                matches = False
            if role == "document web":
                try:
                    current_uri = node.queryDocument().getAttributeValue("URI")
                    matches = (urlparse(current_uri).hostname or "").casefold() == hostname
                except Exception:
                    matches = False
            if not matches:
                continue

            # Present the containing Chrome window, then activate the tab.
            ancestor = node
            try:
                while ancestor and ancestor.getRoleName() != "frame":
                    ancestor = ancestor.parent
                if ancestor:
                    ancestor.queryComponent().grabFocus()
            except Exception:
                pass
            try:
                actions = node.queryAction()
                for index in range(actions.nActions):
                    if actions.getName(index) == "doDefault":
                        actions.doAction(index)
                        return True
            except Exception:
                pass
            try:
                if node.queryComponent().grabFocus():
                    return True
            except Exception:
                pass
    return False


def launch_or_focus(
    url: str, window_class: str, app_mode: bool, profile_directory=None
):
    # App-mode Chrome windows expose the target hostname in WM_CLASS. Prefer
    # that exact, fast path before the broader tab-title scan. Some Facebook
    # page titles include "Messenger", so title matching alone can be noisy.
    if focus_window(window_class) or focus_existing_tab(url):
        return

    # A newly requested Chrome window takes a moment to register its WM class
    # and accessibility tree. Ignore repeat taps during that interval instead
    # of creating a row of duplicate windows.
    now = time.monotonic()
    if now - last_launch_time.get(window_class, 0) < LAUNCH_GUARD_SECONDS:
        return
    last_launch_time[window_class] = now

    command = [
        "google-chrome-stable",
        "--no-first-run",
        "--force-renderer-accessibility",
        "--start-maximized",
        f"--class={window_class}",
    ]
    if profile_directory:
        command.append(f"--profile-directory={profile_directory}")
    if app_mode:
        command.append(f"--app={url}")
    else:
        command.extend(["--new-window", url])
    subprocess.Popen(
        command,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


def adjust_volume(delta: int):
    # Step the same clamped path as the volume keys (see grandma-volume-step for
    # the MAX_VOLUME_PERCENT ceiling). Sharing one helper keeps the whole system
    # on a single limit, so the level can never run away.
    if delta > 0:
        quiet_run(["/usr/local/sbin/grandma-unmute"])
    quiet_run([
        "/usr/local/sbin/grandma-volume-step",
        "up" if delta > 0 else "down",
    ])


def make_image(icon_file, icon_name, px):
    if icon_file:
        path = os.path.join(ICON_DIR, icon_file)
        if os.path.isfile(path):
            try:
                pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, px, px, True)
                return Gtk.Image.new_from_pixbuf(pixbuf)
            except GLib.Error:
                pass
    image = Gtk.Image.new_from_icon_name(icon_name or "web-browser", Gtk.IconSize.DIALOG)
    image.set_pixel_size(px)
    return image


def make_button(label_text, icon_px, icon_file=None, icon_name=None):
    button = Gtk.Button()
    button.set_hexpand(True)
    button.set_vexpand(True)

    contents = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
    contents.set_halign(Gtk.Align.CENTER)
    contents.set_valign(Gtk.Align.CENTER)
    contents.pack_start(make_image(icon_file, icon_name, icon_px), False, False, 0)

    label = Gtk.Label(label=label_text)
    label.set_justify(Gtk.Justification.CENTER)
    label.set_line_wrap(True)
    contents.pack_start(label, False, False, 0)
    button.add(contents)
    return button


def make_volume_button(direction, label_text, icon_px, icon_name):
    """Build a volume control with a speaker and a large directional arrow."""
    button = Gtk.Button()
    button.set_hexpand(True)
    button.set_vexpand(True)

    contents = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
    contents.set_halign(Gtk.Align.CENTER)
    contents.set_valign(Gtk.Align.CENTER)

    symbols = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
    symbols.set_halign(Gtk.Align.CENTER)
    symbols.pack_start(make_image(None, icon_name, icon_px), False, False, 0)

    arrow = Gtk.Label(label="↑" if direction == "up" else "↓")
    arrow.get_style_context().add_class("volume-arrow")
    symbols.pack_start(arrow, False, False, 0)
    contents.pack_start(symbols, False, False, 0)

    label = Gtk.Label(label=label_text)
    label.set_justify(Gtk.Justification.CENTER)
    contents.pack_start(label, False, False, 0)
    button.add(contents)
    return button


class Dock(Gtk.Window):
    def __init__(self):
        super().__init__(title="GrandmaOS Bottom Dock")
        self.set_wmclass("grandmaos-dock", "GrandmaOS-Dock")
        self.set_type_hint(Gdk.WindowTypeHint.DOCK)
        self.set_decorated(False)
        self.set_resizable(False)
        self.set_keep_above(True)
        self.set_skip_pager_hint(True)
        self.set_skip_taskbar_hint(True)
        self.stick()
        self.connect("delete-event", lambda *_args: True)

        screen = Gdk.Screen.get_default()
        monitor_number = screen.get_primary_monitor()
        if monitor_number < 0:
            monitor_number = 0
        self.monitor = screen.get_monitor_geometry(monitor_number)

        # Keep the controls large enough for touch without putting an app
        # button beside the keyboard where a resting hand can hit it. Include
        # one blank, non-clickable column at each end as an edge-touch buffer.
        self.dock_height = max(
            1, min(MAX_DOCK_HEIGHT_PX, self.monitor.height // DOCK_HEIGHT_FRACTION)
        )
        item_width = max(1, self.monitor.width // (len(SITES) + 4))
        site_icon_px = max(
            48, min(88, self.dock_height * 11 // 20, item_width * 2 // 5)
        )
        control_icon_px = max(
            32, min(64, self.dock_height * 2 // 5, item_width * 2 // 5)
        )
        self.set_size_request(self.monitor.width, self.dock_height)
        self.set_default_size(self.monitor.width, self.dock_height)
        self.move(
            self.monitor.x,
            self.monitor.y + self.monitor.height - self.dock_height,
        )

        buttons = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        buttons.set_homogeneous(True)
        self.add(buttons)
        buttons.pack_start(Gtk.Box(), True, True, 0)

        icon_names = {
            "Internet": "web-browser",
            "Banking": "emblem-money",
            "AOL": "web-browser",
        }
        for (
            name,
            url,
            icon_file,
            window_class,
            app_mode,
            profile_directory,
            _open_at_session_start,
        ) in SITES:
            button = make_button(
                name,
                site_icon_px,
                icon_file=icon_file,
                icon_name=icon_names.get(name),
            )
            button.connect(
                "clicked",
                lambda _button, u=url, c=window_class, a=app_mode, p=profile_directory: launch_or_focus(
                    u, c, a, p
                ),
            )
            buttons.pack_start(button, True, True, 0)

        volume_down = make_volume_button(
            "down", "Volume Down", control_icon_px, "audio-volume-low"
        )
        volume_down.set_tooltip_text("Turn the sound down")
        volume_down.connect("clicked", lambda _button: adjust_volume(-1))
        buttons.pack_start(volume_down, True, True, 0)

        volume_up = make_volume_button(
            "up", "Volume Up", control_icon_px, "audio-volume-high"
        )
        volume_up.set_tooltip_text("Turn the sound up")
        volume_up.connect("clicked", lambda _button: adjust_volume(1))
        buttons.pack_start(volume_up, True, True, 0)
        buttons.pack_start(Gtk.Box(), True, True, 0)

    def reserve_desktop_space(self):
        """Publish EWMH struts so maximized windows stop above the dock."""
        gdk_window = self.get_window()
        if not gdk_window:
            return GLib.SOURCE_CONTINUE

        xid = GdkX11.X11Window.get_xid(gdk_window)
        screen_height = Gdk.Screen.get_default().get_height()
        bottom_edge = screen_height - (
            self.monitor.y + self.monitor.height - self.dock_height
        )
        start_x = self.monitor.x
        end_x = self.monitor.x + self.monitor.width - 1
        partial = f"0, 0, 0, {bottom_edge}, 0, 0, 0, 0, 0, 0, {start_x}, {end_x}"
        quiet_run(
            [
                "xprop", "-id", str(xid),
                "-f", "_NET_WM_STRUT_PARTIAL", "32c",
                "-set", "_NET_WM_STRUT_PARTIAL", partial,
            ]
        )
        quiet_run(
            [
                "xprop", "-id", str(xid),
                "-f", "_NET_WM_STRUT", "32c",
                "-set", "_NET_WM_STRUT", f"0, 0, 0, {bottom_edge}",
            ]
        )
        return GLib.SOURCE_REMOVE

    @staticmethod
    def open_everyday_sites_once_this_boot():
        """Open exactly one window for each daily-use site per login session.

        Windows are started one at a time so Chrome has time to register the
        preceding app window.  That avoids a startup race where several
        simultaneous --app requests are routed into the wrong window.
        """
        runtime_dir = os.environ.get("XDG_RUNTIME_DIR")
        if not runtime_dir or not os.path.isdir(runtime_dir):
            return GLib.SOURCE_REMOVE
        marker = os.path.join(runtime_dir, "grandmaos-everyday-sites-started")
        try:
            descriptor = os.open(marker, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
            os.close(descriptor)
        except FileExistsError:
            return GLib.SOURCE_REMOVE

        startup_sites = [site for site in SITES if site[6]]

        def launch_next(index=0):
            if index >= len(startup_sites):
                return GLib.SOURCE_REMOVE
            _name, url, _icon, window_class, app_mode, profile_directory, _start = (
                startup_sites[index]
            )
            launch_or_focus(url, window_class, app_mode, profile_directory)
            GLib.timeout_add_seconds(2, launch_next, index + 1)
            return GLib.SOURCE_REMOVE

        launch_next()
        return GLib.SOURCE_REMOVE


def main():
    provider = Gtk.CssProvider()
    provider.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_screen(
        Gdk.Screen.get_default(),
        provider,
        Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
    )
    dock = Dock()
    dock.show_all()
    GLib.idle_add(dock.reserve_desktop_space)
    GLib.timeout_add_seconds(2, dock.open_everyday_sites_once_this_boot)
    Gtk.main()


if __name__ == "__main__":
    main()
