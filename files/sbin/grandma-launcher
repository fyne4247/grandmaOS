#!/usr/bin/env python3
"""GrandmaOS permanent sidebar.

The sidebar replaces both the fullscreen Apps screen and XFCE's window
switcher. Its fixed site buttons launch a Chrome window or raise the existing
window for that site, while the volume buttons adjust Grandma's own PipeWire
session. The window reserves space at the left edge so Chrome cannot cover it.
"""
import os
import subprocess

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GdkX11", "3.0")
from gi.repository import Gdk, GdkPixbuf, GdkX11, GLib, Gtk  # noqa: E402

ICON_DIR = "/usr/local/share/grandmaos/icons"
MAX_SIDEBAR_PX = 220
SIDEBAR_WIDTH_FRACTION = 10

CSS = b"""
window { background-color: #000000; }
button {
    font-size: 18px;
    font-weight: bold;
    border-radius: 0;
    border-width: 2px;
    padding: 4px;
}
"""

# --class gives each app-style Chrome window a stable identity. That lets the
# same fixed button serve as both launcher and window switcher without showing
# Grandma a separate task list.
SITES = [
    (
        "Facebook",
        "https://www.facebook.com/",
        "facebook.png",
        "GrandmaOS-Facebook",
        True,
    ),
    (
        "YouTube",
        "https://www.youtube.com/",
        "youtube.png",
        "GrandmaOS-YouTube",
        True,
    ),
    ("Internet", "chrome://newtab/", None, "GrandmaOS-Internet", False),
    (
        "Banking",
        "https://www.truist.com/",
        "truist.png",
        "GrandmaOS-Banking",
        True,
    ),
    ("AOL", "https://www.aol.com/", "aol.png", "GrandmaOS-AOL", True),
]


def quiet_run(command):
    try:
        return subprocess.run(
            command,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
    except FileNotFoundError:
        return None


def focus_window(window_class: str) -> bool:
    """Raise a Chrome window previously launched with our stable WM class."""
    try:
        listing = subprocess.check_output(
            ["wmctrl", "-lx"], stderr=subprocess.DEVNULL, text=True
        )
    except (FileNotFoundError, subprocess.CalledProcessError):
        return False

    marker = window_class.casefold()
    for line in listing.splitlines():
        fields = line.split(None, 4)
        if len(fields) >= 4 and marker in fields[3].casefold():
            result = quiet_run(["wmctrl", "-ia", fields[0]])
            return result is not None and result.returncode == 0
    return False


def launch_or_focus(url: str, window_class: str, app_mode: bool):
    if focus_window(window_class):
        return

    command = [
        "google-chrome-stable",
        "--no-first-run",
        "--start-maximized",
        f"--class={window_class}",
    ]
    if app_mode:
        command.append(f"--app={url}")
    else:
        command.extend(["--new-window", url])
    subprocess.Popen(
        command,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


def adjust_volume(delta: int):
    # Step the same clamped path as the volume keys (see grandma-volume-step for
    # the MAX_VOLUME_PERCENT ceiling). Sharing one helper keeps the whole system
    # on a single limit, so the level can never run away.
    if delta > 0:
        quiet_run(["/usr/local/sbin/grandma-unmute"])
    quiet_run([
        "/usr/local/sbin/grandma-volume-step",
        "up" if delta > 0 else "down",
    ])


def make_image(icon_file, icon_name, px):
    if icon_file:
        path = os.path.join(ICON_DIR, icon_file)
        if os.path.isfile(path):
            try:
                pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, px, px, True)
                return Gtk.Image.new_from_pixbuf(pixbuf)
            except GLib.Error:
                pass
    image = Gtk.Image.new_from_icon_name(icon_name or "web-browser", Gtk.IconSize.DIALOG)
    image.set_pixel_size(px)
    return image


def make_button(label_text, icon_px, icon_file=None, icon_name=None):
    button = Gtk.Button()
    button.set_hexpand(True)
    button.set_vexpand(True)

    contents = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
    contents.set_halign(Gtk.Align.CENTER)
    contents.set_valign(Gtk.Align.CENTER)
    contents.pack_start(make_image(icon_file, icon_name, icon_px), False, False, 0)

    label = Gtk.Label(label=label_text)
    label.set_justify(Gtk.Justification.CENTER)
    label.set_line_wrap(True)
    contents.pack_start(label, False, False, 0)
    button.add(contents)
    return button


class Sidebar(Gtk.Window):
    def __init__(self):
        super().__init__(title="GrandmaOS Sidebar")
        self.set_wmclass("grandmaos-sidebar", "GrandmaOS-Sidebar")
        self.set_type_hint(Gdk.WindowTypeHint.DOCK)
        self.set_decorated(False)
        self.set_resizable(False)
        self.set_keep_above(True)
        self.set_skip_pager_hint(True)
        self.set_skip_taskbar_hint(True)
        self.stick()
        self.connect("delete-event", lambda *_args: True)

        screen = Gdk.Screen.get_default()
        monitor_number = screen.get_primary_monitor()
        if monitor_number < 0:
            monitor_number = 0
        self.monitor = screen.get_monitor_geometry(monitor_number)

        # Never consume more than one tenth of the active monitor's logical
        # width. A modest absolute cap avoids an oversized bar on 4K panels.
        self.sidebar_width = max(
            1, min(MAX_SIDEBAR_PX, self.monitor.width // SIDEBAR_WIDTH_FRACTION)
        )
        item_height = max(1, self.monitor.height // (len(SITES) + 2))
        icon_px = max(32, min(72, self.sidebar_width * 2 // 5, item_height * 2 // 5))

        self.set_size_request(self.sidebar_width, self.monitor.height)
        self.set_default_size(self.sidebar_width, self.monitor.height)
        self.move(self.monitor.x, self.monitor.y)

        buttons = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.add(buttons)

        icon_names = {
            "Internet": "web-browser",
            "Banking": "emblem-money",
            "AOL": "web-browser",
        }
        for name, url, icon_file, window_class, app_mode in SITES:
            button = make_button(
                name,
                icon_px,
                icon_file=icon_file,
                icon_name=icon_names.get(name),
            )
            button.connect(
                "clicked",
                lambda _button, u=url, c=window_class, a=app_mode: launch_or_focus(
                    u, c, a
                ),
            )
            buttons.pack_start(button, True, True, 0)

        volume_up = make_button("Volume\nUp", icon_px, icon_name="audio-volume-high")
        volume_up.set_tooltip_text("Turn the sound up")
        volume_up.connect("clicked", lambda _button: adjust_volume(1))
        buttons.pack_start(volume_up, True, True, 0)

        volume_down = make_button("Volume\nDown", icon_px, icon_name="audio-volume-low")
        volume_down.set_tooltip_text("Turn the sound down")
        volume_down.connect("clicked", lambda _button: adjust_volume(-1))
        buttons.pack_start(volume_down, True, True, 0)

    def reserve_desktop_space(self):
        """Publish EWMH struts so maximized windows stop at the sidebar."""
        gdk_window = self.get_window()
        if not gdk_window:
            return GLib.SOURCE_CONTINUE

        xid = GdkX11.X11Window.get_xid(gdk_window)
        left_edge = self.monitor.x + self.sidebar_width
        start_y = self.monitor.y
        end_y = self.monitor.y + self.monitor.height - 1
        partial = f"{left_edge}, 0, 0, 0, {start_y}, {end_y}, 0, 0, 0, 0, 0, 0"
        quiet_run(
            [
                "xprop", "-id", str(xid),
                "-f", "_NET_WM_STRUT_PARTIAL", "32c",
                "-set", "_NET_WM_STRUT_PARTIAL", partial,
            ]
        )
        quiet_run(
            [
                "xprop", "-id", str(xid),
                "-f", "_NET_WM_STRUT", "32c",
                "-set", "_NET_WM_STRUT", f"{left_edge}, 0, 0, 0",
            ]
        )
        return GLib.SOURCE_REMOVE

    @staticmethod
    def open_facebook_once_this_boot():
        runtime_dir = os.environ.get("XDG_RUNTIME_DIR")
        if not runtime_dir or not os.path.isdir(runtime_dir):
            return GLib.SOURCE_REMOVE
        marker = os.path.join(runtime_dir, "grandmaos-facebook-started")
        try:
            descriptor = os.open(marker, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
            os.close(descriptor)
        except FileExistsError:
            return GLib.SOURCE_REMOVE

        _name, url, _icon, window_class, app_mode = SITES[0]
        launch_or_focus(url, window_class, app_mode)
        return GLib.SOURCE_REMOVE


def main():
    provider = Gtk.CssProvider()
    provider.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_screen(
        Gdk.Screen.get_default(),
        provider,
        Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
    )
    sidebar = Sidebar()
    sidebar.show_all()
    GLib.idle_add(sidebar.reserve_desktop_space)
    GLib.timeout_add_seconds(2, sidebar.open_facebook_once_this_boot)
    Gtk.main()


if __name__ == "__main__":
    main()
