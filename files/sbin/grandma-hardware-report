#!/usr/bin/env bash
# Read-only first-boot hardware inventory. It writes no configuration and
# deliberately reports identifiers rather than guessing support requirements.
set -u

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  cat <<'EOF'
Usage: grandma-hardware-report [OUTPUT-FILE]

Collects a read-only hardware/support report. With OUTPUT-FILE, saves the
report there as well as printing it. Run after booting the real Dell:
  sudo grandma-hardware-report ~/grandmaos-dell-hardware.txt
EOF
  exit 0
fi
if [ "$#" -gt 1 ]; then
  echo "error: expected zero or one output-file argument" >&2
  exit 2
fi

out="${1:-}"
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT

section() { printf '\n===== %s =====\n' "$1"; }
run_if_present() {
  local command_name="$1"; shift
  if command -v "$command_name" >/dev/null 2>&1; then
    "$command_name" "$@" 2>&1 || true
  else
    echo "$command_name: not installed"
  fi
}

{
  echo "GrandmaOS Dell first-boot hardware report"
  echo "Generated: $(date --iso-8601=seconds 2>/dev/null || date)"
  echo "Read-only collection: no settings were changed."

  section "OS AND KERNEL"
  run_if_present uname -a
  [ -r /etc/os-release ] && cat /etc/os-release

  section "SYSTEM AND FIRMWARE"
  run_if_present hostnamectl
  run_if_present systemd-detect-virt
  if command -v dmidecode >/dev/null 2>&1 && [ "$(id -u)" -eq 0 ]; then
    dmidecode -t system -t bios 2>&1 || true
  else
    echo "dmidecode: run this report with sudo for SMBIOS/BIOS details"
  fi
  run_if_present mokutil --sb-state

  section "CPU AND MEMORY"
  run_if_present lscpu
  run_if_present free -h

  section "PCI DEVICES AND DRIVERS"
  run_if_present lspci -nnk

  section "USB DEVICES"
  run_if_present lsusb

  section "BLOCK DEVICES"
  run_if_present lsblk -e 7 -o NAME,PATH,SIZE,TYPE,FSTYPE,MOUNTPOINTS,MODEL,TRAN
  run_if_present findmnt -D

  section "GRAPHICS"
  run_if_present glxinfo -B
  run_if_present vainfo
  for card in /sys/class/drm/card*/device/uevent; do
    [ -r "$card" ] && { echo "--- $card"; cat "$card"; }
  done

  section "DISPLAYS"
  run_if_present xrandr --verbose
  for mode in /sys/class/drm/card*-*/modes; do
    [ -r "$mode" ] && { echo "--- $mode"; cat "$mode"; }
  done

  section "INPUT AND TOUCH"
  run_if_present libinput list-devices
  [ -r /proc/bus/input/devices ] && cat /proc/bus/input/devices

  section "AUDIO"
  run_if_present aplay -l
  run_if_present pactl info
  run_if_present wpctl status

  section "NETWORK AND BLUETOOTH"
  run_if_present nmcli device status
  run_if_present rfkill list
  run_if_present bluetoothctl list

  section "POWER, BATTERY, LID, AND SUSPEND"
  run_if_present upower -d
  run_if_present systemctl status systemd-logind --no-pager
  run_if_present systemctl status sleep.target suspend.target hibernate.target hybrid-sleep.target --no-pager
  if [ -r /sys/power/mem_sleep ]; then
    echo -n "/sys/power/mem_sleep: "; cat /sys/power/mem_sleep
  fi
  for battery in /sys/class/power_supply/BAT*; do
    [ -d "$battery" ] || continue
    echo "--- $battery"
    for field in manufacturer model_name technology status capacity cycle_count; do
      [ -r "$battery/$field" ] && printf '%s: %s\n' "$field" "$(cat "$battery/$field")"
    done
  done

  section "FIRMWARE AND BOOT WARNINGS"
  run_if_present fwupdmgr get-devices
  run_if_present journalctl -b -k -p warning..alert --no-pager
} >"$tmp"

cat "$tmp"
if [ -n "$out" ]; then
  install -m 0644 "$tmp" "$out"
  echo "Saved report to: $out" >&2
fi
